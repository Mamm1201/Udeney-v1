# ==== EJEMPLO DE VARIABLES DE ENTORNO PARA EDUNEY ====
# Copia este archivo como .env y configura los valores apropiados

# === SEGURIDAD ===
# Genera una SECRET_KEY única y segura (64+ caracteres)
SECRET_KEY=your-very-long-and-secure-secret-key-here-64-characters-minimum

# Modo debug (NUNCA True en producción)
DEBUG=True

# === BASE DE DATOS ===
DB_NAME=db_ecommerce
DB_USER=your_mysql_user
DB_PASSWORD=your_secure_mysql_password
DB_HOST=localhost
DB_PORT=3306

# === CONFIGURACIÓN DE HOSTS ===
# Hosts permitidos (separados por comas)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Orígenes CORS permitidos (separados por comas)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# === CONFIGURACIÓN DE EMAIL (opcional) ===
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# === CONFIGURACIONES ADICIONALES DE PRODUCCIÓN ===
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True