# ========================================
# GITIGNORE PARA PROYECTO EDUNEY (Django + React)
# ========================================

# =================
# PYTHON / DJANGO
# =================
# Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# Entornos virtuales
venv/
env/
ENV/
.venv/
.ENV/
.python-version

# Archivos de configuración Django
*.log
*.pot
*.pyc
*.pyo
local_settings.py
db.sqlite3
db.sqlite3-journal

# Media files
/media/
/staticfiles/
/static/
/uploads/

# Coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# =================
# VARIABLES DE ENTORNO Y SECRETOS
# =================
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.prod
.env.dev
.env.test
.env.docker

# Archivos de configuración sensibles
config.ini
secrets.json
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der

# =================
# NODE.JS / FRONTEND
# =================
client/node_modules/
client/.env
client/.env.local
client/.env.development.local
client/.env.test.local
client/.env.production.local
client/dist/
client/build/
client/coverage/
client/.nyc_output
client/.cache/
client/.parcel-cache/

# Logs npm
client/npm-debug.log*
client/yarn-debug.log*
client/yarn-error.log*
client/lerna-debug.log*

# =================
# BASES DE DATOS
# =================
*.sqlite3
*.db
*.sqlite
*.sqlite3-journal
dump.rdb

# =================
# LOGS Y TEMPORALES
# =================
logs/
*.log
*.tmp
*.temp
*.swp
*.bak
*~

